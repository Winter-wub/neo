#!/usr/bin/env bun
// Fake `orca` CLI for tests. Appends its argv to $FAKE_ORCA_LOG and answers the read-only commands the agents MCP server uses.
import { appendFileSync } from 'node:fs'
const args = process.argv.slice(2)
if (process.env.FAKE_ORCA_LOG) appendFileSync(process.env.FAKE_ORCA_LOG, JSON.stringify(args) + '\n')
const say = result => console.log(JSON.stringify({ ok: true, result }))
const key = args.slice(0, 2).join(' ')
if (key === 'terminal list') {
  say({ terminals: [{ handle: 'term_0123abcd-4567', title: 'build neo', agentIdentity: 'claude', worktreePath: '/Users/x/repo', branch: 'refs/heads/main', connected: true, lastOutputAt: 1_792_000_000_000, preview: '\x1b[32mgreen\x1b[0m\nline2\nline3\nlast line' }] })
} else if (key === 'terminal read') {
  say({ terminal: { tail: ['one', '', '\x1b[1mtwo\x1b[0m', 'three'] } })
} else if (key === 'orchestration run-list') {
  say({ runs: [{ id: 'run_abc1', objective: 'ship ticket 07', status: 'active', created_at: '2026-10-26' }] })
} else if (key === 'orchestration worker-list') {
  say({ workers: [{ runId: 'run_abc1', workerState: 'busy' }, { runId: 'run_abc1', workerState: 'busy' }, { runId: 'run_zzz', workerState: 'idle' }] })
} else if (key === 'orchestration task-list') {
  say({ tasks: [{ id: 't1', status: 'done', title: 'write tests' }, { id: 't2', status: 'open', spec: 'write code' }] })
} else {
  console.error('fake orca: unknown command ' + args.join(' '))
  process.exit(2)
}
