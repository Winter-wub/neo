#!/usr/bin/env bun
// Fake `claude` for tests (stream-json). Never talks to Anthropic.
// Each call appends {args, env, prompt} to $FAKE_CLAUDE_LOG. The prompt picks the behaviour:
//   contains "@hang"     → starts a helper `sleep` in the same process group, writes both pids to $FAKE_CLAUDE_PIDS, never answers
//   contains "@crash"    → exits 1 without a result
//   contains "@text"     → answers plain text (no JSON)
//   contains "@weather"  → {"intent":"weather",…}
//   contains "@skillhang" → a skill intent whose task contains "@hang" (so the confirmed skill run hangs)
//   contains "@skill"    → {"intent":"skill",…}
//   contains "@error"    → result with is_error
//   contains "memory defragmentation" → a dream (ticket 12): a tool_use, then the dream JSON (memory, insights, patterns, dream, card);
//                          "@dreambad" in the prompt → plain text instead of JSON
//   anything else        → one tool_use, then a card that echoes the question
import { appendFileSync, writeFileSync } from 'node:fs'
import { spawn } from 'node:child_process'

const args = process.argv.slice(2)
let prompt = ''
for await (const chunk of process.stdin) prompt += chunk
const env = {
  CLAUDE_CONFIG_DIR: process.env.CLAUDE_CONFIG_DIR ?? null,
  CLAUDECODE: process.env.CLAUDECODE ?? null,
  CLAUDE_CODE_ENTRYPOINT: process.env.CLAUDE_CODE_ENTRYPOINT ?? null,
  cwd: process.cwd(),
}
if (process.env.FAKE_CLAUDE_LOG) appendFileSync(process.env.FAKE_CLAUDE_LOG, JSON.stringify({ args, env, prompt }) + '\n')

const out = line => process.stdout.write(JSON.stringify(line) + '\n')
const resumeAt = args.indexOf('--resume')
const session = resumeAt >= 0 ? args[resumeAt + 1] : 'sess-' + Math.random().toString(36).slice(2, 8)
const question = (prompt.match(/(?:ผู้ใช้พูดกับคุณว่า|ผู้ใช้พูดต่อ): "([^"]*)"/) ?? [])[1] ?? prompt.slice(0, 40)
const result = text => out({ type: 'result', subtype: 'success', is_error: false, result: text, session_id: session })
const sleep = ms => new Promise(r => setTimeout(r, ms))

out({ type: 'system', subtype: 'init', session_id: session })

if (prompt.includes('@hang')) {
  const helper = spawn('sleep', ['300'], { stdio: 'ignore' })
  if (process.env.FAKE_CLAUDE_PIDS) writeFileSync(process.env.FAKE_CLAUDE_PIDS, `${process.pid} ${helper.pid}`)
  await sleep(300_000)
}
if (prompt.includes('@crash')) process.exit(1)
if (prompt.includes('@error')) {
  out({ type: 'result', subtype: 'error_during_execution', is_error: true, result: 'Credit balance is too low', session_id: session })
  process.exit(0)
}

out({ type: 'assistant', session_id: session, message: { content: [{ type: 'tool_use', name: 'WebSearch', input: { query: question } }] } })
await sleep(20)

if (prompt.includes('memory defragmentation')) {
  if (prompt.includes('@dreambad')) result('ฝันไม่ออก')
  else result(JSON.stringify({
    memory: '## ผู้ใช้\n- ชอบแมวทดสอบระบบ\n- ทำงานด้านสัญญาหลังบ้าน',
    insights: [{ q: 'ทดสอบ', finding: 'ไม่มีอะไรเพิ่ม' }],
    patterns: ['ถามตอนเช้า'],
    dream: 'ฝันถึงปลาทอง',
    card: { title: 'ฝันแล้ว', lines: ['ฝันถึงปลาทอง'] },
  }))
  process.exit(0)
}

if (prompt.includes('@text')) result('ขอโทษครับ ตอบเป็นข้อความธรรมดา')
else if (prompt.includes('@weather')) result('{"intent":"weather","place":"เชียงใหม่","day":1}')
else if (prompt.includes('@skillhang')) result('{"intent":"skill","skill":"jenkins","plan":"ดู build","task":"@hang เปิด jenkins"}')
else if (prompt.includes('@skill')) result('{"intent":"skill","skill":"jenkins","plan":"ดูสถานะ build ล่าสุด","task":"เปิด jenkins แล้วสรุป"}')
else if (prompt.includes('ผู้ใช้สั่ง') && prompt.includes('ยืนยันแล้ว')) result('{"layout":"text","icon":"task","title":"ทำเสร็จแล้ว","lines":["build ล่าสุดผ่านหมด"],"emotion":"proud","sounds":["happy"]}')
else result(JSON.stringify({ layout: 'text', icon: 'search', title: '**คำตอบ**', lines: ['ตอบ: ' + question, 'ที่มา [BBC](https://www.bbc.com/news/1)'], emotion: 'happy', sounds: ['happy'], seconds: 20 }))
