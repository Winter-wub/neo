#!/usr/bin/env bun
// Fake `neo-stt` for tests. One JSON line in, one JSON line out (same as the Swift helper).
//   {wav, hints}        → {text}: the contents of "<wav>.txt", else $FAKE_STT_TEXT, else {error}
//   {op:"check"}        → {status:"authorized", onDevice:true}   ($FAKE_STT_STATUS overrides status)
//   {op:"authorize"}    → same as check
// Appends every request to $FAKE_STT_LOG, and writes its pid to $FAKE_STT_PIDFILE, when set.
import { appendFileSync, readFileSync, writeFileSync } from 'node:fs'
import { createInterface } from 'node:readline'

if (process.env.FAKE_STT_PIDFILE) writeFileSync(process.env.FAKE_STT_PIDFILE, String(process.pid))

for await (const line of createInterface({ input: process.stdin })) {
  if (!line.trim()) continue
  if (process.env.FAKE_STT_LOG) appendFileSync(process.env.FAKE_STT_LOG, line + '\n')
  const req = JSON.parse(line) as { wav?: string; op?: string }
  let reply: unknown
  if (req.op === 'check' || req.op === 'authorize') reply = { status: process.env.FAKE_STT_STATUS ?? 'authorized', onDevice: true }
  else {
    try { reply = { text: readFileSync(`${req.wav}.txt`, 'utf8') } } catch {
      reply = process.env.FAKE_STT_TEXT === undefined ? { error: `ถอดเสียงไม่ได้: ${req.wav}` } : { text: process.env.FAKE_STT_TEXT }
    }
  }
  process.stdout.write(JSON.stringify(reply) + '\n')
}
